# AetherHR — Environment Variables (All Optional — Live UI Configuration Also Supported)

# Cryptographic Signing Secret for Assessment Invitation Tokens & Webhook HMAC-SHA256
AETHER_SIGNING_SECRET=change-this-to-a-strong-256-bit-secret

# Public Base URL (auto-detected on Vercel via VERCEL_URL / Host header)
NEXT_PUBLIC_APP_URL=https://hris-automation.vercel.app

# Email Provider Option A: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AetherHR Talent <noreply@aetherhr.global>

# Email Provider Option B: Custom SMTP (Gmail, Outlook, AWS SES, Zoho)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Provider Option A: Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Provider Option B: Fonnte / Wablas / Custom WhatsApp Webhook Gateway
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# Default Outbound Automation Webhook (Zapier / Make / n8n / Slack / Custom ERP)
DEFAULT_WEBHOOK_URL=
INBOUND_WEBHOOK_API_KEY=aether_live_webhook_key_2026
